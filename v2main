<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Machrozet</title>
    <style>
        :root {
            --bg-color: #F2F1EA;
            --text-color: #000000;
            --font-title: "Swiss911 XCm BT Regular", "Helvetica Neue", Helvetica, Arial, sans-serif;
            --font-main: "Times New Roman", Times, serif;
            --font-mono: "Monospace 821 WGL", "Courier New", monospace;
        }

        html {
            scroll-behavior: smooth;
            background-color: var(--bg-color);
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* --- GLOBAL LINKS (No underlines anywhere) --- */
        a {
            color: var(--text-color);
            text-decoration: none;
            border: none;
            transition: opacity 0.2s ease;
        }
        a:hover {
            text-decoration: none;
            border: none;
            opacity: 0.5;
        }

        /* --- LAYOUT GRID --- */
        .page-wrapper {
            display: flex;
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 40px;
            gap: 80px;
        }

        /* --- LEFT SIDEBAR --- */
        .sidebar {
            width: 210px;
            flex-shrink: 0;
            position: sticky;
            top: 40px;
            height: calc(100vh - 80px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
            scrollbar-width: none;
        }
        .sidebar::-webkit-scrollbar { display: none; }

        .sidebar-top {
            display: flex;
            flex-direction: column;
        }

        .logo {
            width: 100%;
            height: auto;
            margin-bottom: 8px;
            display: block;
        }

        .site-info {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            line-height: 1.3;
            margin-bottom: 40px;
            text-transform: uppercase;
            width: 100%;
        }

        .studio-about {
            display: flex;
            justify-content: space-between;
            width: 100%;
        }

        .nav-menu {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 12px;
            text-transform: uppercase;
        }

        .sidebar-bottom {
            font-family: var(--font-mono);
            font-size: 0.75rem;
        }

        /* --- RIGHT CONTENT AREA --- */
        .content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 120px;
            padding-bottom: 40px;
            max-width: 1100px;
        }

        /* --- EVENT STYLING --- */
        .event-section {
            width: 100%;
        }

        .event-title {
            font-family: var(--font-title);
            font-size: 2rem;
            margin: 0 0 5px 0;
            text-transform: uppercase;
            line-height: 1.1;
        }

        .event-subtitle {
            font-family: var(--font-title);
            font-size: 1.1rem;
            margin: 0 0 15px 0;
            text-transform: uppercase;
        }

        .event-meta {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            margin-bottom: 30px;
            text-transform: uppercase;
            display: block;
        }

        /* TWO COLUMN LAYOUT: Content on left, Bios on right */
        .event-layout {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 60px;
        }
        .event-main {
            display: flex;
            flex-direction: column;
        }
        .event-sidebar {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .event-description {
            font-family: var(--font-main);
            font-size: 1rem;
            line-height: 1.5;
            margin-bottom: 40px;
        }
        .event-description p {
            margin: 0 0 15px 0;
        }
        .event-description h3 {
            font-family: var(--font-main);
            font-size: 1rem;
            margin: 30px 0 10px 0;
            text-transform: uppercase;
        }
        .event-description i {
            font-style: italic;
        }

        /* Two-Column List for Artworks */
        .two-column-list {
            column-count: 2;
            column-gap: 40px;
            margin-bottom: 30px;
        }
        .two-column-list p {
            break-inside: avoid;
            margin-bottom: 20px;
        }

        .boxed-text {
            border: 1px solid var(--text-color);
            padding: 15px;
            margin: 30px 0;
            font-style: italic;
        }

        /* --- VARIED IMAGE LAYOUTS --- */
        .img-block {
            margin-bottom: 30px;
            width: 100%;
        }
        .img-block img {
            width: 100%;
            height: auto;
            display: block;
        }

        .image-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 40px;
        }
        .image-grid img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }

        .grid-varied {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 40px;
        }
        .grid-varied img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .span-2 { grid-column: span 2; }
        .span-3 { grid-column: span 3; }

        /* --- BIO STYLING --- */
        .bio-block {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .bio-img {
            width: 100%;
            max-width: 120px;
            height: auto;
        }
        .bio-text {
            font-family: var(--font-main);
            font-size: 0.9rem;
            line-height: 1.4;
            margin: 0;
        }

        /* --- CREDITS & ICONS --- */
        .photo-credit {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            margin-bottom: 20px;
        }
        .camera-icon {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: #000;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* --- FOOTER --- */
        footer {
            display: flex;
            justify-content: flex-end;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            margin-top: 40px;
        }

        @media (max-width: 900px) {
            .page-wrapper { flex-direction: column; padding: 20px; gap: 40px; }
            .sidebar { width: 100%; position: relative; top: 0; height: auto; }
            .sidebar-bottom { margin-top: 20px; }
            .event-layout { grid-template-columns: 1fr; gap: 40px; }
            .image-grid, .grid-varied { grid-template-columns: 1fr; }
            .span-2, .span-3 { grid-column: span 1; }
            .two-column-list { column-count: 1; }
        }
    </style>
</head>
